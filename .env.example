# ==================================================
# APP / EXPRESS API
# ==================================================
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info

# Public browser URL of the API. NEXT_PUBLIC_* values must never contain secrets.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ==================================================
# DATABASE / PRISMA
# ==================================================
# Local development PostgreSQL only. Never use a production URL here.
DATABASE_URL=postgresql://hello_shop:hello_shop@127.0.0.1:5432/hello_shop?schema=public

# Dedicated local integration-test database. Test runners must copy this value
# into DATABASE_URL only for the integration-test process.
TEST_DATABASE_URL=postgresql://hello_shop:hello_shop@127.0.0.1:5432/hello_shop_test?schema=public

# ==================================================
# AUTHENTICATION
# ==================================================
# Replace for local development. Production rejects secrets shorter than 32 characters.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# ==================================================
# REDIS / BULLMQ
# ==================================================
REDIS_URL=redis://127.0.0.1:6379

# ==================================================
# CORS
# ==================================================
# Comma-separated browser origins accepted by the API.
CORS_ORIGINS=http://localhost:3000

# ==================================================
# LOCAL DEVELOPMENT BOOTSTRAP
# ==================================================
# Bootstrap refuses to run unless NODE_ENV=development and DATABASE_URL is local.
DEV_BOOTSTRAP_EMAIL=owner@example.local
DEV_BOOTSTRAP_PASSWORD=replace-with-a-local-password-of-at-least-12-characters
DEV_BOOTSTRAP_DISPLAY_NAME=Development Owner
DEV_BOOTSTRAP_BUSINESS_NAME=Hello Shop
DEV_BOOTSTRAP_BUSINESS_SLUG=hello-shop-local

# ==================================================
# INTEGRATION TESTS
# ==================================================
# Integration tests remain skipped unless explicitly enabled.
# Never enable this while DATABASE_URL points anywhere except a dedicated local *_test database.
RUN_DATABASE_INTEGRATION=false
