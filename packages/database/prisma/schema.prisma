generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  REMOVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  OTHER
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ApprovalActionType {
  SALE_HIGH_DISCOUNT
  PURCHASE_POST
  SALE_RETURN_POST
  PURCHASE_RETURN_POST
  DAMAGE_POST
  EXPENSE_POST
  FINANCIAL_MONEY_OUT
  FINANCIAL_TRANSFER
  FINANCIAL_ADJUSTMENT
  MANUAL_JOURNAL_POST
  JOURNAL_REVERSE
  FISCAL_PERIOD_CLOSE
  TEAM_ROLE_CHANGE
  TEAM_SUSPEND
}

enum ApprovalThresholdType {
  NONE
  ALWAYS
  AMOUNT
  PERCENTAGE
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  EXECUTING
  REJECTED
  CANCELLED
  EXPIRED
  EXECUTED
  STALE
}

enum ApprovalDecisionType {
  APPROVED
  REJECTED
}

enum WarrantyUnit {
  DAYS
  MONTHS
  YEARS
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DEALER
  CORPORATE
  OTHER
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  TRANSFER_IN
  TRANSFER_OUT
}

enum StockAdjustmentReason {
  OPENING_BALANCE
  PHYSICAL_COUNT
  DAMAGE_CORRECTION
  LOST
  FOUND
  DATA_CORRECTION
  OTHER
}

enum SerialStatus {
  IN_STOCK
  RESERVED
  SOLD
  RETURNED
  DAMAGED
  IN_RMA
  SENT_TO_SUPPLIER
  RECEIVED_FROM_SUPPLIER
  DELIVERED_TO_CUSTOMER
  SCRAPPED
  RETURNED_TO_SUPPLIER
}

enum DamageStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum DamageReason {
  BROKEN
  WATER_DAMAGE
  FIRE_DAMAGE
  ELECTRICAL_DAMAGE
  SHIPPING_DAMAGE
  HANDLING_DAMAGE
  EXPIRED
  UNUSABLE
  MISSING_PARTS
  OTHER
}

enum ExpenseStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ExpensePaymentMethod {
  CASH
  BANK
  BKASH
  NAGAD
  CARD
  OTHER
}

enum FinancialAccountType {
  CASH
  BANK
  BKASH
  NAGAD
  CARD
  OTHER
}

enum FinancialTransactionType {
  OPENING_BALANCE
  MONEY_IN
  MONEY_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum FinancialDirection {
  IN
  OUT
}

enum FinancialTransactionStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum AccountingAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountingNormalBalance {
  DEBIT
  CREDIT
}

enum AccountingSystemKey {
  CASH_AND_BANK
  ACCOUNTS_RECEIVABLE
  INVENTORY
  INPUT_VAT
  OTHER_CURRENT_ASSET
  ACCOUNTS_PAYABLE
  EXPENSE_PAYABLE
  VAT_PAYABLE
  OTHER_CURRENT_LIABILITY
  OWNER_CAPITAL
  RETAINED_EARNINGS
  OPENING_BALANCE_EQUITY
  SALES_REVENUE
  SERVICE_REVENUE
  OTHER_INCOME
  SALES_RETURN
  COGS
  INVENTORY_DAMAGE_LOSS
  RENT_EXPENSE
  UTILITY_EXPENSE
  MARKETING_EXPENSE
  DELIVERY_EXPENSE
  OTHER_EXPENSE
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum OpenItemStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PartyCreditKind {
  CUSTOMER_CREDIT
  SUPPLIER_CREDIT
}

enum PartyCreditStatus {
  AVAILABLE
  PARTIALLY_APPLIED
  APPLIED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SaleType {
  REGULAR
  VAT
  POS
}

enum SaleStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ReturnStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum RmaStatus {
  RECEIVED
  INSPECTING
  APPROVED
  REJECTED
  SENT_TO_SUPPLIER
  SUPPLIER_PROCESSING
  SUPPLIER_RETURNED
  READY_FOR_CUSTOMER
  DELIVERED
  CANCELLED
}

enum RmaIssue {
  NOT_POWERING_ON
  DISPLAY_ISSUE
  BATTERY_ISSUE
  CHARGING_ISSUE
  HARDWARE_FAILURE
  SOFTWARE_ISSUE
  PHYSICAL_DAMAGE
  OTHER
}

enum RmaCondition {
  GOOD
  SCRATCHED
  DENTED
  BROKEN
  LIQUID_DAMAGE
  OTHER
}

enum WarrantyDecision {
  WARRANTY_APPROVED
  WARRANTY_REJECTED
  OUT_OF_WARRANTY
  CUSTOMER_DAMAGE
  PAID_SERVICE_REQUIRED
}

enum RmaOutcome {
  REPAIRED
  REPLACED
  REJECTED
  NO_FAULT_FOUND
  CUSTOMER_DAMAGE
  UNREPAIRABLE
}

enum ServiceStatus {
  RECEIVED
  DIAGNOSING
  WAITING_FOR_APPROVAL
  IN_PROGRESS
  WAITING_FOR_PARTS
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ServiceType {
  REPAIR
  DIAGNOSTIC
  INSTALLATION
  SOFTWARE
  HARDWARE
  MAINTENANCE
  OTHER
}

enum ServicePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum PurchaseReturnReason {
  WRONG_ITEM
  DAMAGED
  SUPPLIER_REQUEST
  EXCESS_STOCK
  OTHER
}

enum SaleReturnReason {
  CUSTOMER_RETURN
  DEFECTIVE
  WRONG_ITEM
  EXCHANGE
  OTHER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  passwordHash           String
  displayName            String
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  memberships            BusinessMembership[]
  sessions               LoginSession[]
  auditLogs              AuditLog[]             @relation("AuditActor")
  categories             Category[]             @relation("CategoryCreator")
  subCategories          SubCategory[]          @relation("SubCategoryCreator")
  brands                 Brand[]                @relation("BrandCreator")
  units                  Unit[]                 @relation("UnitCreator")
  products               Product[]              @relation("ProductCreator")
  customers              Customer[]             @relation("CustomerCreator")
  suppliers              Supplier[]             @relation("SupplierCreator")
  warehouses             Warehouse[]            @relation("WarehouseCreator")
  stockMovements         StockMovement[]        @relation("StockMovementCreator")
  stockAdjustments       StockAdjustment[]      @relation("StockAdjustmentCreator")
  purchasesCreated       Purchase[]             @relation("PurchaseCreator")
  purchasesPosted        Purchase[]             @relation("PurchasePoster")
  purchasesCancelled     Purchase[]             @relation("PurchaseCanceller")
  salesCreated           Sale[]                 @relation("SaleCreator")
  salesPosted            Sale[]                 @relation("SalePoster")
  salesCancelled         Sale[]                 @relation("SaleCanceller")
  purchaseReturnsCreated PurchaseReturn[]       @relation("PurchaseReturnCreator")
  purchaseReturnsPosted  PurchaseReturn[]       @relation("PurchaseReturnPoster")
  saleReturnsCreated     SaleReturn[]           @relation("SaleReturnCreator")
  saleReturnsPosted      SaleReturn[]           @relation("SaleReturnPoster")
  rmasCreated            Rma[]                  @relation("RmaCreator")
  rmaHistory             RmaHistory[]           @relation("RmaHistoryActor")
  serviceJobsCreated     ServiceJob[]           @relation("ServiceCreator")
  serviceJobsAssigned    ServiceJob[]           @relation("ServiceAssignee")
  serviceJobsDelivered   ServiceJob[]           @relation("ServiceDeliverer")
  serviceHistory         ServiceHistory[]       @relation("ServiceHistoryActor")
  quotationsCreated      Quotation[]            @relation("QuotationCreator")
  quotationHistory       QuotationHistory[]     @relation("QuotationHistoryActor")
  damagesCreated         Damage[]               @relation("DamageCreator")
  damagesPosted          Damage[]               @relation("DamagePoster")
  expensesCreated        Expense[]              @relation("ExpenseCreator")
  expensesPosted         Expense[]              @relation("ExpensePoster")
  expenseCategories      ExpenseCategory[]      @relation("ExpenseCategoryCreator")
  financialAccounts      FinancialAccount[]     @relation("FinancialAccountCreator")
  financialTransactions  FinancialTransaction[] @relation("FinancialTransactionCreator")
  financialTransfers     FinancialTransfer[]    @relation("FinancialTransferCreator")
  chartAccountsCreated   ChartAccount[]         @relation("ChartAccountCreator")
  journalsCreated        JournalEntry[]         @relation("JournalCreator")
  journalsPosted         JournalEntry[]         @relation("JournalPoster")
  teamInvitationsSent    TeamInvitation[]       @relation("TeamInvitationSender")
  rolesCreated           Role[]                 @relation("RoleCreator")
  approvalPoliciesMade   ApprovalPolicy[]       @relation("ApprovalPolicyCreator")
  approvalsRequested     ApprovalRequest[]      @relation("ApprovalRequester")
  approvalsReviewed      ApprovalRequest[]      @relation("ApprovalReviewer")
  approvalDecisions      ApprovalDecision[]     @relation("ApprovalDecisionReviewer")
}

model Business {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  memberships            BusinessMembership[]
  roles                  Role[]
  sessions               LoginSession[]
  auditLogs              AuditLog[]
  categories             Category[]
  subCategories          SubCategory[]
  brands                 Brand[]
  units                  Unit[]
  products               Product[]
  customers              Customer[]
  suppliers              Supplier[]
  sequences              BusinessSequence[]
  warehouses             Warehouse[]
  stockMovements         StockMovement[]
  stockBalances          StockBalance[]
  stockAdjustments       StockAdjustment[]
  serialItems            SerialItem[]
  purchases              Purchase[]
  sales                  Sale[]
  invoices               Invoice[]
  subscription           BusinessSubscription?
  purchaseReturns        PurchaseReturn[]
  saleReturns            SaleReturn[]
  serialHistory          SerialHistory[]
  rmas                   Rma[]
  rmaHistory             RmaHistory[]
  serviceJobs            ServiceJob[]
  serviceHistory         ServiceHistory[]
  quotations             Quotation[]
  quotationHistory       QuotationHistory[]
  damages                Damage[]
  expenses               Expense[]
  expenseCategories      ExpenseCategory[]
  financialAccounts      FinancialAccount[]
  financialTransactions  FinancialTransaction[]
  financialTransfers     FinancialTransfer[]
  accountingSettings     AccountingSettings?
  chartAccounts          ChartAccount[]
  fiscalPeriods          FiscalPeriod[]
  journalEntries         JournalEntry[]
  journalLines           JournalLine[]
  receivableItems        ReceivableItem[]
  receivableAllocations  ReceivableAllocation[]
  payableItems           PayableItem[]
  payableAllocations     PayableAllocation[]
  partyCredits           PartyCredit[]
  creditApplications     PartyCreditApplication[]
  inventoryCostStates    InventoryCostState[]
  inventoryCostMovements InventoryCostMovement[]
  teamInvitations        TeamInvitation[]
  approvalPolicies       ApprovalPolicy[]
  approvalRequests       ApprovalRequest[]
  approvalDecisions      ApprovalDecision[]

  @@index([createdAt])
}

model BusinessSubscription {
  id             String             @id @default(cuid())
  businessId     String             @unique
  planCode       String?
  status         SubscriptionStatus @default(TRIALING)
  trialStartedAt DateTime
  trialEndsAt    DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([status, trialEndsAt])
}

model Category {
  id            String        @id @default(cuid())
  businessId    String
  name          String
  slug          String
  description   String?
  isActive      Boolean       @default(true)
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("CategoryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  subCategories SubCategory[]
  products      Product[]

  @@unique([businessId, slug])
  @@index([businessId, isActive])
}

model SubCategory {
  id          String    @id @default(cuid())
  businessId  String
  categoryId  String
  name        String
  slug        String
  description String?
  isActive    Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy   User      @relation("SubCategoryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([businessId, categoryId, slug])
  @@index([businessId, isActive])
  @@index([businessId, categoryId])
}

model Brand {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  slug        String
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy   User      @relation("BrandCreator", fields: [createdById], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([businessId, slug])
  @@index([businessId, isActive])
}

model Unit {
  id             String    @id @default(cuid())
  businessId     String
  name           String
  shortName      String
  decimalAllowed Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy      User      @relation("UnitCreator", fields: [createdById], references: [id], onDelete: Restrict)
  products       Product[]

  @@unique([businessId, name])
  @@unique([businessId, shortName])
  @@index([businessId, isActive])
}

model Product {
  id                     String                  @id @default(cuid())
  businessId             String
  name                   String
  slug                   String
  sku                    String
  barcode                String?
  categoryId             String
  subCategoryId          String?
  brandId                String?
  unitId                 String
  description            String?
  purchasePrice          Decimal                 @db.Decimal(18, 2)
  salePrice              Decimal                 @db.Decimal(18, 2)
  dealerPrice            Decimal?                @db.Decimal(18, 2)
  minimumSalePrice       Decimal?                @db.Decimal(18, 2)
  trackStock             Boolean                 @default(true)
  serialized             Boolean                 @default(false)
  reorderLevel           Decimal                 @default(0) @db.Decimal(18, 3)
  allowNegativeStock     Boolean                 @default(false)
  warrantyEnabled        Boolean                 @default(false)
  warrantyDuration       Int?
  warrantyUnit           WarrantyUnit?
  primaryImageUrl        String?
  isActive               Boolean                 @default(true)
  createdById            String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  version                Int                     @default(1)
  business               Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category               Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory            SubCategory?            @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  brand                  Brand?                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  unit                   Unit                    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy              User                    @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Restrict)
  stockMovements         StockMovement[]
  stockBalances          StockBalance[]
  adjustmentLines        StockAdjustmentLine[]
  serialItems            SerialItem[]
  purchaseLines          PurchaseLine[]
  saleLines              SaleLine[]
  purchaseReturnLines    PurchaseReturnLine[]
  saleReturnLines        SaleReturnLine[]
  rmas                   Rma[]
  serviceJobs            ServiceJob[]
  serviceParts           ServicePart[]
  quotationLines         QuotationLine[]
  damageLines            DamageLine[]
  journalLines           JournalLine[]
  inventoryCostStates    InventoryCostState[]
  inventoryCostMovements InventoryCostMovement[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@unique([businessId, slug])
  @@index([businessId, isActive])
  @@index([businessId, categoryId])
  @@index([businessId, brandId])
}

model Warehouse {
  id                     String                  @id @default(cuid())
  businessId             String
  name                   String
  code                   String
  description            String?
  address                String?
  isDefault              Boolean                 @default(false)
  isActive               Boolean                 @default(true)
  createdById            String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  business               Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy              User                    @relation("WarehouseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  movements              StockMovement[]
  balances               StockBalance[]
  adjustments            StockAdjustment[]
  serialItems            SerialItem[]
  purchases              Purchase[]
  sales                  Sale[]
  purchaseReturns        PurchaseReturn[]
  saleReturns            SaleReturn[]
  damages                Damage[]
  inventoryCostStates    InventoryCostState[]
  inventoryCostMovements InventoryCostMovement[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@index([businessId, isDefault])
}

model StockMovement {
  id            String                 @id @default(cuid())
  businessId    String
  warehouseId   String
  productId     String
  type          StockMovementType
  quantity      Decimal                @db.Decimal(18, 3)
  referenceType String?
  referenceId   String?
  unitCost      Decimal?               @db.Decimal(18, 2)
  note          String?
  occurredAt    DateTime               @default(now())
  createdById   String
  createdAt     DateTime               @default(now())
  business      Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy     User                   @relation("StockMovementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  costMovement  InventoryCostMovement?

  @@index([businessId, productId])
  @@index([businessId, warehouseId])
  @@index([businessId, productId, warehouseId])
  @@index([businessId, occurredAt])
  @@index([referenceType, referenceId])
}

model StockBalance {
  id          String    @id @default(cuid())
  businessId  String
  warehouseId String
  productId   String
  quantity    Decimal   @default(0) @db.Decimal(18, 3)
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([businessId, warehouseId, productId])
  @@index([businessId, productId])
  @@index([businessId, warehouseId])
}

model StockAdjustment {
  id          String                @id @default(cuid())
  businessId  String
  warehouseId String
  reason      StockAdjustmentReason
  note        String?
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  business    Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User                  @relation("StockAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines       StockAdjustmentLine[]

  @@index([businessId, createdAt])
  @@index([businessId, warehouseId])
}

model StockAdjustmentLine {
  id           String            @id @default(cuid())
  adjustmentId String
  productId    String
  direction    StockMovementType
  quantity     Decimal           @db.Decimal(18, 3)
  unitCost     Decimal?          @db.Decimal(18, 2)
  adjustment   StockAdjustment   @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([adjustmentId])
  @@index([productId])
}

model SerialItem {
  id            String        @id @default(cuid())
  businessId    String
  warehouseId   String
  productId     String
  serialNumber  String
  status        SerialStatus  @default(IN_STOCK)
  purchaseId    String?
  saleId        String?
  customerId    String?
  supplierId    String?
  warrantyStart DateTime?
  warrantyEnd   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  damageSerial  DamageSerial?
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchase      Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  sale            Sale?           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  history         SerialHistory[]
  rmas            Rma[]           @relation("RmaOriginalSerial")
  replacementRmas Rma[]           @relation("RmaReplacementSerial")
  serviceJobs     ServiceJob[]

  @@unique([businessId, serialNumber])
  @@index([businessId, productId])
  @@index([businessId, warehouseId])
  @@index([businessId, status])
}

model Purchase {
  id                    String           @id @default(cuid())
  businessId            String
  purchaseNumber        String
  supplierId            String
  warehouseId           String
  supplierInvoiceNumber String?
  reference             String?
  purchaseDate          DateTime
  dueDate               DateTime?
  subtotal              Decimal          @db.Decimal(18, 2)
  discountAmount        Decimal          @default(0) @db.Decimal(18, 2)
  additionalCost        Decimal          @default(0) @db.Decimal(18, 2)
  taxAmount             Decimal          @default(0) @db.Decimal(18, 2)
  grandTotal            Decimal          @db.Decimal(18, 2)
  paidAmount            Decimal          @default(0) @db.Decimal(18, 2)
  dueAmount             Decimal          @db.Decimal(18, 2)
  note                  String?
  status                PurchaseStatus   @default(DRAFT)
  createdById           String
  postedById            String?
  postedAt              DateTime?
  cancelledById         String?
  cancelledAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  version               Int              @default(1)
  business              Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplier              Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse             Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy             User             @relation("PurchaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy              User?            @relation("PurchasePoster", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy           User?            @relation("PurchaseCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines                 PurchaseLine[]
  serialItems           SerialItem[]
  returns               PurchaseReturn[]
  payable               PayableItem?

  @@unique([businessId, purchaseNumber])
  @@index([businessId, status])
  @@index([businessId, supplierId])
  @@index([businessId, warehouseId])
  @@index([businessId, purchaseDate])
}

model PurchaseLine {
  id               String               @id @default(cuid())
  businessId       String
  purchaseId       String
  productId        String
  quantity         Decimal              @db.Decimal(18, 3)
  unitCost         Decimal              @db.Decimal(18, 2)
  discountAmount   Decimal              @default(0) @db.Decimal(18, 2)
  taxAmount        Decimal              @default(0) @db.Decimal(18, 2)
  lineTotal        Decimal              @db.Decimal(18, 2)
  warrantyDuration Int?
  warrantyUnit     WarrantyUnit?
  serialNumbers    String[]
  createdAt        DateTime             @default(now())
  purchase         Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product          Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
