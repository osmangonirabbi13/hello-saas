  @@index([businessId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([businessId, action, createdAt])
}

model TeamInvitation {
  id           String               @id @default(cuid())
  businessId   String
  email        String
  roleId       String
  invitedById  String
  tokenHash    String               @unique
  status       TeamInvitationStatus @default(PENDING)
  jobTitle     String?
  employeeCode String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  role         Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User                 @relation("TeamInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([businessId, status, createdAt])
  @@index([businessId, email, status])
  @@index([expiresAt, status])
}

model ApprovalPolicy {
  id                String                @id @default(cuid())
  businessId        String
  actionType        ApprovalActionType
  enabled           Boolean               @default(false)
  thresholdType     ApprovalThresholdType @default(NONE)
  thresholdValue    Decimal?              @db.Decimal(18, 4)
  requiredApprovals Int                   @default(1)
  approverRoleId    String?
  allowSelfApproval Boolean               @default(false)
  expiresAfterHours Int?
  createdById       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  approverRole      Role?                 @relation(fields: [approverRoleId], references: [id], onDelete: Restrict)
  createdBy         User                  @relation("ApprovalPolicyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  requests          ApprovalRequest[]

  @@unique([businessId, actionType])
  @@index([businessId, enabled, actionType])
}

model ApprovalRequest {
  id                String                @id @default(cuid())
  businessId        String
  policyId          String
  approvalNumber    String
  actionType        ApprovalActionType
  status            ApprovalRequestStatus @default(PENDING)
  requestedById     String
  reviewedById      String?
  reason            String
  requesterNote     String?
  reviewerNote      String?
  sourceType        String
  sourceId          String
  sourceVersion     Int
  payloadSnapshot   Json
  payloadHash       String
  requestedAt       DateTime              @default(now())
  reviewedAt        DateTime?
  expiresAt         DateTime?
  executedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  policy            ApprovalPolicy        @relation(fields: [policyId], references: [id], onDelete: Restrict)
  requestedBy       User                  @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy        User?                 @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  decisions         ApprovalDecision[]

  @@unique([businessId, approvalNumber])
  @@index([businessId, status, requestedAt])
  @@index([businessId, actionType, status])
  @@index([businessId, sourceType, sourceId, status])
  @@index([businessId, requestedById, requestedAt])
}

model ApprovalDecision {
  id                String               @id @default(cuid())
  businessId        String
  approvalRequestId String
  reviewerId        String
  decision          ApprovalDecisionType
  note              String?
  createdAt         DateTime             @default(now())
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  approvalRequest   ApprovalRequest      @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  reviewer          User                 @relation("ApprovalDecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([approvalRequestId, reviewerId])
  @@index([businessId, createdAt])
}

model Damage {
  id               String       @id @default(cuid())
  businessId       String
  damageNumber     String
  warehouseId      String
  damageDate       DateTime
  reason           DamageReason
  notes            String?
  status           DamageStatus @default(DRAFT)
  totalDamageValue Decimal      @default(0) @db.Decimal(18, 2)
  createdById      String
  postedById       String?
  postedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  version          Int          @default(1)
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  warehouse        Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy        User         @relation("DamageCreator", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy         User?        @relation("DamagePoster", fields: [postedById], references: [id], onDelete: Restrict)
  lines            DamageLine[]

  @@unique([businessId, damageNumber])
  @@index([businessId, status, damageDate])
  @@index([businessId, warehouseId])
}

model DamageLine {
  id               String         @id @default(cuid())
  businessId       String
  damageId         String
  productId        String
  quantity         Decimal        @db.Decimal(18, 3)
  unitCostSnapshot Decimal        @db.Decimal(18, 2)
  totalDamageValue Decimal        @db.Decimal(18, 2)
  createdAt        DateTime       @default(now())
  damage           Damage         @relation(fields: [damageId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  serials          DamageSerial[]

  @@unique([damageId, productId])
  @@index([businessId, productId])
}

model DamageSerial {
  damageLineId String
  serialItemId String
  createdAt    DateTime   @default(now())
  damageLine   DamageLine @relation(fields: [damageLineId], references: [id], onDelete: Cascade)
  serialItem   SerialItem @relation(fields: [serialItemId], references: [id], onDelete: Restrict)

  @@id([damageLineId, serialItemId])
  @@unique([serialItemId])
}

model ExpenseCategory {
  id             String        @id @default(cuid())
  businessId     String
  name           String
  description    String?
  chartAccountId String?
  isActive       Boolean       @default(true)
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy      User          @relation("ExpenseCategoryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  expenses       Expense[]
  chartAccount   ChartAccount? @relation(fields: [chartAccountId], references: [id], onDelete: Restrict)

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@index([businessId, chartAccountId])
}

model Expense {
  id            String                @id @default(cuid())
  businessId    String
  expenseNumber String
  categoryId    String
  expenseDate   DateTime
  amount        Decimal               @db.Decimal(18, 2)
  description   String
  payee         String?
  paymentMethod ExpensePaymentMethod?
  reference     String?
  notes         String?
  status        ExpenseStatus         @default(DRAFT)
  createdById   String
  postedById    String?
  postedAt      DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  version       Int                   @default(1)
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category      ExpenseCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy     User                  @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy      User?                 @relation("ExpensePoster", fields: [postedById], references: [id], onDelete: Restrict)

  @@unique([businessId, expenseNumber])
  @@index([businessId, status, expenseDate])
  @@index([businessId, categoryId, expenseDate])
  @@index([businessId, paymentMethod])
}

model FinancialAccount {
  id             String                 @id @default(cuid())
  businessId     String
  accountCode    String
  name           String
  type           FinancialAccountType
  description    String?
  bankName       String?
  accountHolder  String?
  accountNumber  String?
  branch         String?
  mobileNumber   String?
  chartAccountId String?
  isActive       Boolean                @default(true)
  createdById    String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  business       Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy      User                   @relation("FinancialAccountCreator", fields: [createdById], references: [id], onDelete: Restrict)
  transactions   FinancialTransaction[]
  chartAccount   ChartAccount?          @relation(fields: [chartAccountId], references: [id], onDelete: Restrict)
  journalLines   JournalLine[]
  transfersOut   FinancialTransfer[]    @relation("TransferSourceAccount")
  transfersIn    FinancialTransfer[]    @relation("TransferDestinationAccount")

  @@unique([businessId, accountCode])
  @@unique([businessId, name])
  @@index([businessId, type, isActive])
  @@index([businessId, createdAt])
  @@index([businessId, chartAccountId])
}

model FinancialTransaction {
  id                   String                     @id @default(cuid())
  businessId           String
  accountId            String
  transferId           String?
  transactionNo        String
  type                 FinancialTransactionType
  direction            FinancialDirection
  status               FinancialTransactionStatus @default(POSTED)
  amount               Decimal                    @db.Decimal(18, 2)
  transactionDate      DateTime
  description          String
  counterparty         String?
  reference            String?
  notes                String?
  sourceType           String?
  sourceId             String?
  createdById          String
  postedAt             DateTime                   @default(now())
  createdAt            DateTime                   @default(now())
  account              FinancialAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  business             Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  transfer             FinancialTransfer?         @relation(fields: [transferId], references: [id], onDelete: Restrict)
  createdBy            User                       @relation("FinancialTransactionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  receivableAllocation ReceivableAllocation?
  payableAllocation    PayableAllocation?

  @@unique([businessId, transactionNo])
  @@index([businessId, accountId, transactionDate, createdAt])
  @@index([businessId, type, direction])
  @@index([businessId, status, transactionDate])
  @@index([businessId, sourceType, sourceId])
}

model FinancialTransfer {
  id                   String                 @id @default(cuid())
  businessId           String
  transferNo           String
  sourceAccountId      String
  destinationAccountId String
  amount               Decimal                @db.Decimal(18, 2)
  transferDate         DateTime
  reference            String?
  notes                String?
  createdById          String
  postedAt             DateTime               @default(now())
  createdAt            DateTime               @default(now())
  business             Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sourceAccount        FinancialAccount       @relation("TransferSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount   FinancialAccount       @relation("TransferDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  createdBy            User                   @relation("FinancialTransferCreator", fields: [createdById], references: [id], onDelete: Restrict)
  transactions         FinancialTransaction[]

  @@unique([businessId, transferNo])
  @@index([businessId, transferDate])
  @@index([businessId, sourceAccountId])
  @@index([businessId, destinationAccountId])
}

model ChartAccount {
  id                 String                  @id @default(cuid())
  businessId         String
  code               String
  name               String
  accountType        AccountingAccountType
  accountSubType     String?
  normalBalance      AccountingNormalBalance
  systemKey          AccountingSystemKey?
  parentId           String?
  description        String?
  isSystem           Boolean                 @default(false)
  allowManualPosting Boolean                 @default(true)
  isActive           Boolean                 @default(true)
  createdById        String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  business           Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy          User                    @relation("ChartAccountCreator", fields: [createdById], references: [id], onDelete: Restrict)
  parent             ChartAccount?           @relation("ChartAccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           ChartAccount[]          @relation("ChartAccountHierarchy")
  financialAccounts  FinancialAccount[]
  expenseCategories  ExpenseCategory[]
  journalLines       JournalLine[]

  @@unique([businessId, code])
  @@unique([businessId, systemKey])
  @@index([businessId, accountType, isActive])
  @@index([businessId, parentId])
}

model AccountingSettings {
  id                            String   @id @default(cuid())
  businessId                    String   @unique
  accountingEnabled             Boolean  @default(false)
  fiscalYearStartMonth          Int      @default(1)
  receivableAccountId           String?
  payableAccountId              String?
  expensePayableAccountId       String?
  inventoryAccountId            String?
  salesRevenueAccountId         String?
  serviceRevenueAccountId       String?
  cogsAccountId                 String?
  salesReturnAccountId          String?
  damageLossAccountId           String?
  inputVatAccountId             String?
  outputVatAccountId            String?
  openingBalanceEquityAccountId String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  business                      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
}

model FiscalPeriod {
  id         String             @id @default(cuid())
  businessId String
  name       String
  startDate  DateTime
  endDate    DateTime
  status     FiscalPeriodStatus @default(OPEN)
  version    Int                @default(1)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  journals   JournalEntry[]

  @@unique([businessId, name])
  @@index([businessId, status, startDate, endDate])
}

model JournalEntry {
  id                    String                 @id @default(cuid())
  businessId            String
  journalNumber         String
  date                  DateTime
  memo                  String
  status                JournalStatus          @default(DRAFT)
  version               Int                    @default(1)
  sourceType            String
  sourceId              String
  sourceEvent           String
  fiscalPeriodId        String
  createdById           String
  postedById            String?
  postedAt              DateTime?
  reversalOfId          String?
  reversedById          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  fiscalPeriod          FiscalPeriod           @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  createdBy             User                   @relation("JournalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy              User?                  @relation("JournalPoster", fields: [postedById], references: [id], onDelete: Restrict)
  reversalOf            JournalEntry?          @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal              JournalEntry?          @relation("JournalReversal")
  lines                 JournalLine[]
  receivableAllocations ReceivableAllocation[]
  payableAllocations    PayableAllocation[]
  creditApplications    PartyCreditApplication[]

  @@unique([businessId, journalNumber])
  @@unique([businessId, sourceType, sourceId, sourceEvent])
  @@unique([reversalOfId])
  @@index([businessId, status, date])
  @@index([businessId, fiscalPeriodId])
}

model JournalLine {
  id                 String            @id @default(cuid())
  businessId         String
  journalEntryId     String
  accountId          String
  debit              Decimal           @default(0) @db.Decimal(18, 2)
  credit             Decimal           @default(0) @db.Decimal(18, 2)
  description        String?
  customerId         String?
  supplierId         String?
  financialAccountId String?
  productId          String?
  sourceLineId       String?
  createdAt          DateTime          @default(now())
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  journalEntry       JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account            ChartAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  product            Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([businessId, accountId, createdAt])
  @@index([businessId, customerId])
  @@index([businessId, supplierId])
  @@index([businessId, productId])
}

model ReceivableItem {
  id             String                 @id @default(cuid())
  businessId     String
  customerId     String?
  saleId         String                 @unique
  invoiceId      String?
  originalAmount Decimal                @db.Decimal(18, 2)
  settledAmount  Decimal                @default(0) @db.Decimal(18, 2)
  dueDate        DateTime?
  status         OpenItemStatus         @default(OPEN)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  business       Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer       Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale           Sale                   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  allocations    ReceivableAllocation[]
  creditApplications PartyCreditApplication[]

  @@index([businessId, status, dueDate])
  @@index([businessId, customerId, status])
}

model ReceivableAllocation {
  id                     String               @id @default(cuid())
  businessId             String
  receivableItemId       String
  financialTransactionId String               @unique
  journalEntryId         String               @unique
  amount                 Decimal              @db.Decimal(18, 2)
  allocatedAt            DateTime
  createdAt              DateTime             @default(now())
  business               Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  receivableItem         ReceivableItem       @relation(fields: [receivableItemId], references: [id], onDelete: Restrict)
  financialTransaction   FinancialTransaction @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)
  journalEntry           JournalEntry         @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@index([businessId, receivableItemId, allocatedAt])
}

model PayableItem {
  id             String              @id @default(cuid())
  businessId     String
  supplierId     String
  purchaseId     String              @unique
  originalAmount Decimal             @db.Decimal(18, 2)
  settledAmount  Decimal             @default(0) @db.Decimal(18, 2)
  dueDate        DateTime?
  status         OpenItemStatus      @default(OPEN)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase       Purchase            @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  allocations    PayableAllocation[]
  creditApplications PartyCreditApplication[]

  @@index([businessId, status, dueDate])
  @@index([businessId, supplierId, status])
}

model PayableAllocation {
  id                     String               @id @default(cuid())
  businessId             String
  payableItemId          String
  financialTransactionId String               @unique
  journalEntryId         String               @unique
  amount                 Decimal              @db.Decimal(18, 2)
  allocatedAt            DateTime
  createdAt              DateTime             @default(now())
  business               Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  payableItem            PayableItem          @relation(fields: [payableItemId], references: [id], onDelete: Restrict)
  financialTransaction   FinancialTransaction @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)
  journalEntry           JournalEntry         @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@index([businessId, payableItemId, allocatedAt])
}

model PartyCredit {
  id            String            @id @default(cuid())
  businessId    String
  kind          PartyCreditKind
  customerId    String?
  supplierId    String?
  sourceType    String
  sourceId      String
  documentNumber String
  originalAmount Decimal          @db.Decimal(18, 2)
  appliedAmount  Decimal          @default(0) @db.Decimal(18, 2)
  status         PartyCreditStatus @default(AVAILABLE)
  occurredAt     DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier       Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  applications   PartyCreditApplication[]

  @@unique([businessId, sourceType, sourceId])
  @@index([businessId, kind, status, occurredAt])
  @@index([businessId, customerId, status])
  @@index([businessId, supplierId, status])
}

model PartyCreditApplication {
  id               String         @id @default(cuid())
  businessId       String
  partyCreditId    String
  receivableItemId String?
  payableItemId    String?
  journalEntryId   String         @unique
  amount           Decimal        @db.Decimal(18, 2)
  appliedAt        DateTime
  sourceType       String
  sourceId         String
  createdAt        DateTime       @default(now())
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  partyCredit      PartyCredit    @relation(fields: [partyCreditId], references: [id], onDelete: Restrict)
  receivableItem   ReceivableItem? @relation(fields: [receivableItemId], references: [id], onDelete: Restrict)
  payableItem      PayableItem?   @relation(fields: [payableItemId], references: [id], onDelete: Restrict)
  journalEntry     JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@unique([businessId, sourceType, sourceId])
  @@index([businessId, partyCreditId, appliedAt])
  @@index([businessId, receivableItemId])
  @@index([businessId, payableItemId])
}

model InventoryCostState {
  id              String    @id @default(cuid())
  businessId      String
  warehouseId     String
  productId       String
  quantity        Decimal   @default(0) @db.Decimal(18, 3)
  totalCost       Decimal   @default(0) @db.Decimal(18, 2)
  averageUnitCost Decimal   @default(0) @db.Decimal(18, 6)
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([businessId, warehouseId, productId])
  @@index([businessId, productId])
}

model InventoryCostMovement {
  id              String        @id @default(cuid())
  businessId      String
  warehouseId     String
  productId       String
  stockMovementId String        @unique
  quantityDelta   Decimal       @db.Decimal(18, 3)
  unitCost        Decimal       @db.Decimal(18, 6)
  totalCostDelta  Decimal       @db.Decimal(18, 2)
  costBefore      Decimal       @db.Decimal(18, 2)
  costAfter       Decimal       @db.Decimal(18, 2)
  averageBefore   Decimal       @db.Decimal(18, 6)
  averageAfter    Decimal       @db.Decimal(18, 6)
  sourceType      String
  sourceId        String
  createdAt       DateTime      @default(now())
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovement   StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)

  @@index([businessId, warehouseId, productId, createdAt])
  @@index([businessId, sourceType, sourceId])
}
