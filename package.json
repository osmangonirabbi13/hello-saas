{
  "name": "hello-shop-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "corepack pnpm --recursive --if-present build",
    "dev": "corepack pnpm --parallel --recursive --if-present dev",
    "dev:frontend": "corepack pnpm --filter @hello-shop/frontend dev",
    "dev:api": "corepack pnpm --filter @hello-shop/api dev",
    "dev:worker": "corepack pnpm --filter @hello-shop/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "corepack pnpm --recursive --if-present lint",
    "typecheck": "corepack pnpm --recursive --if-present typecheck",
    "test": "corepack pnpm --recursive --if-present test",
    "db:generate": "pnpm --filter @hello-shop/database generate",
    "db:migrate:dev": "pnpm --filter @hello-shop/database migrate:dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.17.2",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
